# ==============================================================
# VARIABLES D'ENVIRONNEMENT — Cockpit Commercial PFS
# Copier ce fichier en .env et remplir toutes les valeurs.
# Ne jamais committer le fichier .env réel.
# ==============================================================

# ── Base de données ───────────────────────────────────────────
# Fourni par Render (onglet "Connect" de la base PostgreSQL).
# Exemple : postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ───────────────────────────────────────────────────────
# Chaîne aléatoire d'au moins 64 caractères.
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ROTATION : si ce secret est compromis, changer la valeur ET
#   mettre à jour sur Render → tous les tokens existants seront révoqués.
JWT_SECRET=remplacer_par_une_chaine_secrete_longue_et_aleatoire_64_chars_min

# ── CORS ──────────────────────────────────────────────────────
# URL exacte du frontend (sans slash final).
# En production, obligatoire — le serveur refuse de démarrer si absent.
# Exemple : https://cockpit-pfs.onrender.com
FRONTEND_URL=https://votre-frontend.onrender.com

# ── Environnement ─────────────────────────────────────────────
# "production" sur Render, "development" en local.
NODE_ENV=production

# ── Compte superadmin initial (optionnel) ─────────────────────
# Si défini, le superadmin est créé/mis à jour au démarrage.
# À ne définir qu'une fois, puis supprimer ces variables de Render.
SUPERADMIN_EMAIL=admin@votre-organisation.com
SUPERADMIN_PASSWORD=remplacer_par_mdp_fort_16_chars_min
SUPERADMIN_NOM=Super Admin PFS
